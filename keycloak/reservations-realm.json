{
  "realm": "reservations",
  "enabled": true,
  "defaultSignatureAlgorithm": "RS256",
  "roles": {
    "realm": [
      {
        "name": "reservation_writer",
        "description": "Allows creating, updating and deleting reservations"
      }
    ]
  },
  "clients": [
    {
      "clientId": "reservations-test",
      "name": "Reservations API test client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [],
      "protocolMappers": [
        {
          "name": "reservations-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "included.custom.audience": "reservations-api"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-reservations-test",
      "enabled": true,
      "serviceAccountClientId": "reservations-test",
      "realmRoles": ["reservation_writer"]
    }
  ]
}
